{
  "name": "jobhunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/apps/server/src/main.js",
    "open": "node scripts/open.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "format": "prettier --write apps packages tests scripts/*.mjs *.ts *.json README.md AGENTS.md docs",
    "smoke:research": "node scripts/research-smoke.mjs",
    "gmail:connect": "node scripts/gmail.mjs connect",
    "gmail:status": "node scripts/gmail.mjs status",
    "gmail:enable-read": "node scripts/gmail.mjs enable-read",
    "start:approval": "node scripts/start-approval.mjs",
    "gmail:disconnect": "node scripts/gmail.mjs disconnect",
    "audit:eml": "tsx scripts/audit-eml.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "@napi-rs/keyring": "2.1.0",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "fastify": "5.12.5",
    "lucide-react": "1.52.0",
    "nodemailer": "10.0.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
