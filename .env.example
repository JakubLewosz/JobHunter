# No secrets. Defaults are safe: DEMO default, loopback only.
JOBHUNTER_PORT=4317
# Optional absolute directory outside this repository; DEMO is separate; research/approval share personal data.
# JOBHUNTER_DATA_DIR=

# DEMO, RESEARCH_ONLY or APPROVAL_REQUIRED; stop the backend before changing mode.
JOBHUNTER_MODE=DEMO
# Native CLI path (codex.exe on Windows); uses official ChatGPT login, no API key.
# JOBHUNTER_CODEX_PATH=
